{
  "name": "vark-ui-platform",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "lint:affected": "nx affected -t lint",
    "lint:affected:local": "nx affected -t lint --uncommitted",
    "typecheck:affected": "nx affected -t typecheck",
    "typecheck:affected:local": "nx affected -t typecheck --uncommitted",
    "build:affected": "nx affected -t build",
    "build:affected:local": "nx affected -t build --uncommitted",
    "test:affected": "nx affected -t test",
    "test:affected:local": "nx affected -t test --uncommitted",
    "e2e:affected": "nx affected -t e2e",
    "e2e:affected:local": "nx affected -t e2e --uncommitted",
    "format:affected": "nx format:write --base=origin/main --head=HEAD --sort-root-tsconfig-paths=false && git diff -z --name-only --diff-filter=ACMR origin/main...HEAD | xargs -0 -r prettier --ignore-unknown --write",
    "format:affected:check": "nx format:check --base=${NX_BASE:-origin/main} --head=${NX_HEAD:-HEAD} --sort-root-tsconfig-paths=false && git diff -z --name-only --diff-filter=ACMR ${NX_BASE:-origin/main}...${NX_HEAD:-HEAD} | xargs -0 -r prettier --ignore-unknown --check",
    "format:affected:local": "nx format:write --uncommitted --sort-root-tsconfig-paths=false && git diff -z --name-only --diff-filter=ACMR | xargs -0 -r prettier --ignore-unknown --write",
    "format:affected:check:local": "nx format:check --uncommitted --sort-root-tsconfig-paths=false && git diff -z --name-only --diff-filter=ACMR | xargs -0 -r prettier --ignore-unknown --check",
    "check:affected": "npm run lint:affected && npm run typecheck:affected && npm run format:affected:check",
    "check:affected:local": "npm run lint:affected:local && npm run typecheck:affected:local && npm run format:affected:check:local",
    "lint:all": "nx run-many --target=lint --all",
    "typecheck:all": "nx run-many --target=typecheck --all",
    "check:all": "npm run lint:all && npm run typecheck:all",
    "format:all": "nx format:write --all --sort-root-tsconfig-paths=false",
    "format:check:all": "nx format:check --all --sort-root-tsconfig-paths=false",
    "e2e:report:vark": "npx playwright show-report dist/.playwright/apps/vark-e2e/playwright-report"
  },
  "private": true,
  "overrides": {
    "@nx/angular": {
      "picomatch": "4.0.4"
    },
    "@nx/js": {
      "picomatch": "4.0.4"
    },
    "@nx/workspace": {
      "picomatch": "4.0.4"
    }
  },
  "dependencies": {
    "@angular/common": "~20.3.18",
    "@angular/compiler": "~20.3.18",
    "@angular/core": "~20.3.18",
    "@angular/forms": "~20.3.18",
    "@angular/platform-browser": "~20.3.18",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.18",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2003.22",
    "@angular-devkit/core": "~20.3.22",
    "@angular-devkit/schematics": "~20.3.22",
    "@angular/build": "~20.3.22",
    "@angular/cli": "~20.3.22",
    "@angular/compiler-cli": "~20.3.18",
    "@angular/language-service": "~20.3.18",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.6.3",
    "@nx/devkit": "22.6.3",
    "@nx/eslint": "22.6.3",
    "@nx/eslint-plugin": "22.6.3",
    "@nx/jest": "22.6.3",
    "@nx/js": "22.6.3",
    "@nx/playwright": "22.6.3",
    "@nx/web": "22.6.3",
    "@nx/workspace": "22.6.3",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~20.3.22",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "^29.5.12",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "jest-util": "^29.7.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.6.3",
    "prettier": "~3.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.40.0"
  }
}
